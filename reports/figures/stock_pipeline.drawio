Cell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Three barriers per day&lt;/b&gt;&lt;br&gt;take-profit P0 e^(+0.75 sigma sqrt10)&lt;br&gt;stop-loss  P0 e^(-0.75 sigma sqrt10)&lt;br&gt;time limit 10 days&lt;br&gt;-&gt; 36 % / 29 % / 35 %" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="430" width="260" height="130" as="geometry"/></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n6" target="n21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Fractional diff.&lt;/b&gt;&lt;br&gt;d = 0.30-0.45&lt;br&gt;stationary, yet 0.92-0.99&lt;br&gt;correlated with price" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="335" y="430" width="200" height="130" as="geometry"/></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n8" target="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Purge + embargo&lt;/b&gt;&lt;br&gt;drop events whose 10-day outcome&lt;br&gt;crosses a split border&lt;br&gt;+ 10-day embargo&lt;br&gt;53,592 events ~ 8,300 independent" style="fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="550" y="430" width="250" height="130" as="geometry"/></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n9" target="n25"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;2.1 · What the labels look like&lt;/b&gt;" style="fontFamily=Helvetica;fontColor=#000000