<mxCell id="n51" value="Phases 3-7 · not built here: how a quant system turns a signal into trades (guideline for readers)" style="opacity=35;textOpacity=35;fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#000000;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="1190" width="1640" height="36" as="geometry"/></mxCell><mxCell id="n52" value="" style="opacity=35;textOpacity=35;fontFamily=Helvetica;fontColor=#000000;rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1;" vertex="1" parent="1"><mxGeometry x="30" y="1240" width="1640" height="350" as="geometry"/></mxCell><mxCell id="n53" value="&lt;b&gt;Inactive in this project: next steps to complete the trading loop&lt;/b&gt;" style="opacity=35;textOpacity=35;fontFamily=Helvetica;fontColor=#000000;text;html=1;align=center;" vertex="1" parent="1"><mxGeometry x="30" y="1245" width="1640" height="30" as="geometry"/></mxCell><mxCell id="n54" value="Phase 3&lt;br&gt;Signal + threshold" style="opacity=35;textOpacity=35;fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="55" y="1315" width="230" height="70" as="geometry"/></mxCell><mxCell id="n55" value="&lt;b&gt;Signal + threshold&lt;/b&gt;&lt;br&gt;trade only if P(take-profit)&lt;br&gt;beats P(stop-loss) by a margin&lt;br&gt;threshold tuned on validation" style="opacity=35;textOpacity=35;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="25" y="1450" width="290" height="105" as="geometry"/></mxCell><mxCell id="e56" value="" style="opacity=35;textOpacity=35;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWid