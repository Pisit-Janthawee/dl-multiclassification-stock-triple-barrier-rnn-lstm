or,&lt;br&gt;stop-loss = the lower barrier" style="opacity=35;textOpacity=35;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="685" y="1450" width="290" height="105" as="geometry"/></mxCell><mxCell id="e62" value="" style="opacity=35;textOpacity=35;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n60" target="n61"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n63" value="Phase 6&lt;br&gt;Executor" style="opacity=35;textOpacity=35;fontFamily=Helvetica;fontColor=#000000;rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=#000000;strokeWidth=1;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1045" y="1315" width="230" height="70" as="geometry"/></mxCell><mxCell id="n64" value="&lt;b&gt;Executor&lt;/b&gt;&lt;br&gt;orders via a broker API,&lt;br&gt;slippage and fees,&lt;br&gt;partial fills" style="opacity=35;textOpacity=35;fontFamily=Helvetica;fontColor=#000000;rounded=1;arcSize=6;whiteSpace=wrap;html=1;dashed=1;fillColor=#fafafa;strokeColor=#000000;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1015" y="1450" width="290" height="105" as="geometry"/></mxCell><mxCell id="e65" value="" style="opacity=35;textOpacity=35;edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;strokeWidth=1;fontSize=10;fontStyle=2;fontFamily=Helvetica;fontColor=#000000;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="n63" target="n64"><mxGeometry 